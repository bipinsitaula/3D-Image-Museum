{
  "name": "museum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Walkable 3D image museum (three.js + Express)",
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.js --port 3000\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
