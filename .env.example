# Copy to .env and fill in. Never commit .env.

# Password for the Admin login in the museum.
ADMIN_PASSWORD=change-me

# Long random string used to sign admin tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port the Node server listens on (nginx proxies to this).
PORT=3000

# Set to 1 when running behind nginx so login rate-limiting sees real client IPs.
TRUST_PROXY=0
